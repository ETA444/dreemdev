{
  // ===== EDITOR BASICS =====
  "editor.fontSize": 13,
  "editor.fontFamily": "Menlo, Monaco, 'Courier New', monospace",
  "editor.lineHeight": 1.6,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.wordWrap": "on",
  "editor.rulers": [
    80,
    120
  ],
  "editor.renderWhitespace": "selection",
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": true,
  // ===== THEME & APPEARANCE =====
  "workbench.colorTheme": "Dracula",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "window.zoomLevel": 0,
  "workbench.editor.enablePreview": false,
  // ===== PYTHON CONFIGURATION =====
  // python.defaultInterpreterPath removed from global settings intentionally.
  // Set it per-project in .vscode/settings.json for repos that use a .venv.
  "python.analysis.typeCheckingMode": "basic",
  "python.terminal.activateEnvironment": true,
  // Language-specific Python editor settings
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    }
  },
  // Ruff extension configuration
  // ruff.lint.run removed — deprecated ruff-lsp setting.
  // On-save linting is handled via source.fixAll above.
  "ruff.importStrategy": "fromEnvironment",
  // Black extension configuration (commented out since Ruff is main formatter)
  // To switch to Black, remove the [python] block above and uncomment:
  // "python.formatting.provider": "black",
  // "[python]": {
  //   "editor.defaultFormatter": "ms-python.black-formatter",
  //   "editor.formatOnSave": true,
  //   "editor.codeActionsOnSave": {
  //     "source.organizeImports": "explicit"
  //   }
  // },
  // ===== JUPYTER / DATA SCIENCE =====
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "jupyter.askForKernelRestart": false,
  "jupyter.sendSelectionToInteractiveWindow": true,
  // ===== GIT CONFIGURATION =====
  "git.autofetch": true,
  "git.autorefresh": true,
  "git.confirmSync": false,
  "gitlens.hovers.currentLine.enabled": false,
  "gitlens.statusBar.enabled": true,
  "gitlens.codeLens.enabled": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  // ===== TERMINAL =====
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.lineHeight": 1.5,
  "terminal.integrated.inheritEnv": true,
  // ===== FILES & EXCLUDE =====
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true,
    "**/.venv": true,
    "**/venv": true,
    "**/.env": true,
    "**/.DS_Store": true,
    "**/.ipynb_checkpoints": true
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  // ===== SEARCH =====
  "search.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/venv": true,
    "**/.venv": true,
    "**/.ipynb_checkpoints": true
  },
  // ===== EXTENSIONS =====
  "extensions.ignoreRecommendations": false,
  // ===== MARKDOWN & DOCUMENTATION =====
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false
  },
  // ===== SECURITY =====
  "security.workspace.trust.untrustedFiles": "open",
  "telemetry.telemetryLevel": "off"
}
