  // =====================
  // 1. File / module headers
  // =====================
  "Python Script Header": {
    "prefix": "py-header",
    "body": [
      "\"\"\"",
      "Script: ${1:script_name}.py",
      "Description: ${2:Short description of this script}.",
      "Author: ${3:George Dreemer}",
      "Created: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      "\"\"\"",
      "",
      "from __future__ import annotations",
      "",
      "import logging",
      "from pathlib import Path",
      "",
      "logging.basicConfig(",
      "    level=logging.${4|INFO,DEBUG,WARNING,ERROR|},",
      "    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'",
      ")",
      "logger = logging.getLogger(__name__)",
      "",
      "ROOT_DIR = Path(__file__).resolve().parent",
      "DATA_DIR = ROOT_DIR / 'data'",
      "OUTPUT_DIR = ROOT_DIR / 'output'",
      "",
      "",
      "def main() -> None:",
      "    \"\"\"${5:Entry point for the script.}\"\"\"",
      "    ${6:logger.info(\"Starting script...\")}",
      "",
      "",
      "if __name__ == '__main__':",
      "    main()",
      "$0"
    ],
    "description": "Standard Python script header with logging and path constants"
  },
  "Jupyter Notebook Header": {
    "prefix": "nb-header",
    "body": [
      "\"\"\"",
      "Analysis: ${1:Analysis Name}",
      "Author: ${2:George Dreemer}",
      "Date: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
