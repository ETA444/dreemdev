      "plt.style.use('${3|seaborn-v0_8-darkgrid,seaborn-v0_8-whitegrid,ggplot,dark_background|}')",
      "sns.set_theme(style='${4|darkgrid,whitegrid,dark,white,ticks|}')",
      "",
      "$0"
    ],
    "description": "Jupyter notebook standard header for data analysis"
  },
  // =====================
  // 2. Data loading & basic EDA
  // =====================
  "Data Analysis Template": {
    "prefix": "da-start",
    "body": [
      "import pandas as pd",
      "import numpy as np",
      "import matplotlib.pyplot as plt",
      "import seaborn as sns",
      "from pathlib import Path",
      "",
      "DATA_PATH = Path('${1:data}')",
      "FILE_NAME = '${2:data.csv}'",
      "",
      "df = pd.read_csv(DATA_PATH / FILE_NAME)",
      "",
      "print(f'Shape: {df.shape}')",
      "print(df.dtypes)",
      "display(df.head())",
      "",
      "display(df.describe(include='all'))",
      "",
      "$0"
    ],
    "description": "Quick data analysis starter with pathlib and descriptive stats"
  },
  "EDA Overview Block": {
    "prefix": "da-eda-overview",
    "body": [
      "# --- EDA: Overview ---",
      "print('Shape:', df.shape)",
      "print('\nDtypes:')",
      "print(df.dtypes)",
      "",
      "print('\nMissing values:')",
      "print(df.isna().sum().sort_values(ascending=False))",
      "",
      "print('\nUnique values per column:')",
      "print(df.nunique().sort_values(ascending=False))",
      "",
      "$0"
    ],
    "description": "High-level EDA overview: shape, dtypes, missingness, cardinality"
  },
  "EDA Numeric Summary": {
    "prefix": "da-eda-num",
    "body": [
      "# --- EDA: Numeric columns ---",
      "num_cols = df.select_dtypes(include=['number']).columns.tolist()",
      "print('Numeric columns:', num_cols)",
      "",
      "display(df[num_cols].describe().T)",
      "",
      "fig, axes = plt.subplots(nrows=${1:2}, ncols=${2:3}, figsize=(${3:16}, ${4:8}))",
      "axes = axes.flatten()",
      "for i, col in enumerate(num_cols[: len(axes)]):",
      "    sns.histplot(df[col].dropna(), kde=True, ax=axes[i])",
      "    axes[i].set_title(col)",
      "plt.tight_layout()",
      "",
      "$0"
    ],
    "description": "Numeric EDA: describe and histogram grid"
  },
  "EDA Categorical Summary": {
    "prefix": "da-eda-cat",
    "body": [
      "# --- EDA: Categorical columns ---",
      "cat_cols = df.select_dtypes(include=['object', 'category']).columns.tolist()",
      "print('Categorical columns:', cat_cols)",
      "",
      "for col in cat_cols:",
      "    print(f'\nColumn: {col}')",
      "    display(df[col].value_counts(dropna=False).head(${1:20}))",
      "",
      "$0"
    ],
    "description": "Categorical EDA: value counts for top categories"
  },
  "EDA Correlation Heatmap": {
    "prefix": "da-eda-corr",
    "body": [
      "# --- EDA: Correlation heatmap ---",
      "num_cols = df.select_dtypes(include=['number']).columns",
      "corr = df[num_cols].corr(numeric_only=True)",
      "",
      "plt.figure(figsize=(${1:12}, ${2:8}))",
      "sns.heatmap(corr, annot=False, cmap='coolwarm', center=0)",
      "plt.title('${3:Correlation heatmap}')",
      "plt.tight_layout()",
      "",
      "$0"
    ],
    "description": "Correlation heatmap for numeric columns"
  },
  "Missingness Heatmap": {
    "prefix": "da-missing",
    "body": [
      "# --- Missingness heatmap ---",
      "plt.figure(figsize=(${1:12}, ${2:6}))",
      "sns.heatmap(df.isna(), cbar=False)",
      "plt.title('${3:Missing values heatmap}')",
      "plt.tight_layout()",
      "",
      "$0"
    ],
    "description": "Quick missingness heatmap"
  },
  // =====================
  // 3. Pandas utilities
  // =====================
  "Memory Usage Summary": {
    "prefix": "pd-mem",
    "body": [
      "# --- DataFrame memory usage ---",
      "mem = df.memory_usage(deep=True).sum() / 1024 ** 2",
      "print(f'Memory usage: {mem:.2f} MB')",
      "",
      "display(df.memory_usage(deep=True).sort_values(ascending=False) / 1024 ** 2)",
      "",
      "$0"
    ],
    "description": "Summarize DataFrame memory usage in MB"
  },
  "Optimize Dtypes": {
    "prefix": "pd-optimize",
    "body": [
      "# --- Optimize dtypes for numeric and categorical columns ---",
      "df_optimized = df.copy()",
      "",
      "for col in df_optimized.select_dtypes(include=['float']).columns:",
      "    df_optimized[col] = pd.to_numeric(df_optimized[col], downcast='float')",
      "",
      "for col in df_optimized.select_dtypes(include=['integer']).columns:",
      "    df_optimized[col] = pd.to_numeric(df_optimized[col], downcast='integer')",
      "",
      "for col in df_optimized.select_dtypes(include=['object']).columns:",
      "    num_unique = df_optimized[col].nunique()",
      "    num_total = len(df_optimized[col])",
      "    if num_unique / num_total < ${1:0.5}:",
      "        df_optimized[col] = df_optimized[col].astype('category')",
      "",
      "before = df.memory_usage(deep=True).sum() / 1024 ** 2",
      "after = df_optimized.memory_usage(deep=True).sum() / 1024 ** 2",
      "print(f'Before: {before:.2f} MB, After: {after:.2f} MB, Saved: {before - after:.2f} MB')",
      "",
      "$0"
    ],
    "description": "Heuristic dtype optimization for pandas DataFrames"
  },
  "Groupby Summary": {
    "prefix": "pd-group",
    "body": [
      "group_cols = ['${1:group_col}']",
      "agg_col = '${2:value_col}'",
      "",
      "summary = (",
      "    df.groupby(group_cols)[agg_col]",
      "      .agg(['count', 'mean', 'median', 'min', 'max'])",
      ")",
      "",
      "display(summary.sort_values('mean', ascending=False).head(${3:10}))",
      "",
      "$0"
    ],
    "description": "Common groupby aggregation summary"
  },
  "Pivot Table": {
    "prefix": "pd-pivot",
    "body": [
      "pivot = df.pivot_table(",
      "    values='${1:value_col}',",
      "    index='${2:index_col}',",
      "    columns='${3:columns_col}',",
      "    aggfunc='${4:mean}',",
      ")",
      "display(pivot.head())",
      "",
      "$0"
    ],
    "description": "Pivot table helper"
  },
