  // =====================
  // 5. Scikit-learn ML pipelines
  // =====================
  "ML Supervised Pipeline": {
    "prefix": "ml-pipeline",
    "body": [
      "from sklearn.model_selection import train_test_split",
      "from sklearn.preprocessing import StandardScaler",
      "from sklearn.pipeline import Pipeline",
      "from sklearn.${1|linear_model,ensemble,svm,neighbors|} import ${2:LogisticRegression}",
      "from sklearn.metrics import classification_report, confusion_matrix",
      "",
      "FEATURE_COLS = ${3:['col1', 'col2']}",
      "TARGET_COL = '${4:target}'",
      "",
      "X = df[FEATURE_COLS]",
      "y = df[TARGET_COL]",
      "",
      "X_train, X_test, y_train, y_test = train_test_split(",
      "    X, y, test_size=${5:0.2}, random_state=${6:42}, stratify=y",
      ")",
      "",
      "clf = Pipeline(steps=[",
      "    ('scaler', StandardScaler()),",
      "    ('model', ${2:LogisticRegression}()),",
      "])",
      "",
      "clf.fit(X_train, y_train)",
      "y_pred = clf.predict(X_test)",
      "",
      "print(classification_report(y_test, y_pred))",
      "print(confusion_matrix(y_test, y_pred))",
      "",
      "$0"
    ],
    "description": "Standard supervised classification pipeline with scaling and metrics"
  },
  "ML Regression Pipeline": {
    "prefix": "ml-reg-pipeline",
    "body": [
      "from sklearn.model_selection import train_test_split",
      "from sklearn.preprocessing import StandardScaler",
      "from sklearn.pipeline import Pipeline",
      "from sklearn.${1|linear_model,ensemble,svm,neighbors|} import ${2:RandomForestRegressor}",
      "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score",
      "",
      "FEATURE_COLS = ${3:['col1', 'col2']}",
      "TARGET_COL = '${4:target}'",
      "",
      "X = df[FEATURE_COLS]",
      "y = df[TARGET_COL]",
      "",
      "X_train, X_test, y_train, y_test = train_test_split(",
      "    X, y, test_size=${5:0.2}, random_state=${6:42}",
      ")",
      "",
      "reg = Pipeline(steps=[",
      "    ('scaler', StandardScaler()),",
      "    ('model', ${2:RandomForestRegressor}()),",
      "])",
      "",
      "reg.fit(X_train, y_train)",
      "y_pred = reg.predict(X_test)",
      "",
      "mae = mean_absolute_error(y_test, y_pred)",
      "rmse = mean_squared_error(y_test, y_pred, squared=False)",
      "r2 = r2_score(y_test, y_pred)",
      "print(f'MAE: {mae:.4f}, RMSE: {rmse:.4f}, R2: {r2:.4f}')",
      "",
      "$0"
    ],
    "description": "Regression pipeline with scaling and common regression metrics"
  },
  "Cross Validation": {
    "prefix": "ml-cv",
    "body": [
      "from sklearn.model_selection import cross_val_score",
      "",
      "scores = cross_val_score(",
      "    estimator=${1:model},",
      "    X=${2:X},",
      "    y=${3:y},",
      "    cv=${4:5},",
      "    scoring='${5|accuracy,f1,roc_auc,r2,neg_mean_squared_error|}'",
      ")",
      "print(f'CV scores: {scores}')",
      "print(f'Mean: {scores.mean():.4f} ± {scores.std():.4f}')",
      "$0"
    ],
    "description": "Generic cross validation block"
  },
  "Grid Search CV": {
    "prefix": "ml-grid",
    "body": [
      "from sklearn.model_selection import GridSearchCV",
      "",
      "param_grid = {",
      "    '${1:model_name}__${2:param}': [${3:values}],",
      "}",
      "",
      "grid = GridSearchCV(",
      "    estimator=${4:pipe},",
      "    param_grid=param_grid,",
      "    cv=${5:5},",
      "    scoring='${6|accuracy,f1,roc_auc,r2,neg_mean_squared_error|}',",
      "    n_jobs=${7:-1},",
      ")",
      "",
      "grid.fit(${8:X_train}, ${9:y_train})",
      "print('Best params:', grid.best_params_)",
      "print('Best score:', grid.best_score_)",
      "",
      "$0"
    ],
    "description": "Grid search cross-validation helper"
  },
